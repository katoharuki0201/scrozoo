{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "bun x auth@latest generate --output ./src/db/auth-schema.ts --yes"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@libsql/client": "^0.17.4",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "~6.0.2"
  }
}
